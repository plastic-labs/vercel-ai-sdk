{
  "name": "@honcho/ai-sdk",
  "version": "0.1.0",
  "description": "Honcho memory for the Vercel AI SDK -- persistent identity, theory-of-mind, dialectic reasoning",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai-sdk": {
      "import": "./dist/ai-sdk/index.js",
      "types": "./dist/ai-sdk/index.d.ts"
    },
    "./openai": {
      "import": "./dist/openai/index.js",
      "types": "./dist/openai/index.d.ts"
    },
    "./dreaming": {
      "import": "./dist/dreaming/index.js",
      "types": "./dist/dreaming/index.d.ts"
    },
    "./identity": {
      "import": "./dist/identity/index.js",
      "types": "./dist/identity/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env src/test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck",
    "publish:check": "npm run typecheck && npm pack --dry-run"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "honcho",
    "memory",
    "personalization",
    "tools",
    "vercel-ai",
    "openai"
  ],
  "author": "Plastic Labs <hello@plasticlabs.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plastic-labs/vercel-ai-sdk-package.git"
  },
  "homepage": "https://github.com/plastic-labs/vercel-ai-sdk-package#readme",
  "bugs": {
    "url": "https://github.com/plastic-labs/vercel-ai-sdk-package/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.0.1"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": false
    },
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
